#!/usr/bin/env bash
# Make a project ready to work on in Orca on this machine (or another one), doing only
# the steps that are missing:
#   1. folder on disk    (clone from GitHub if the repo exists there, else create it)
#   2. git repo          (git init + first commit if needed)
#   3. GitHub repo       (create it, private by default, and push; only for GITHUB_OWNER)
#   4. Orca project      (import the folder: orca project setup-existing-folder)
#
#   ensure-project <name> [--owner <owner>] [--path <dir>] [--public] [--on <machine>] [--dry-run]
#
#   <name>      GitHub repo name (also the folder name unless --path)
#   --owner     GitHub owner (default GITHUB_OWNER in chiefofstaff.conf)
#   --path      folder on the target machine (default ~/$PROJECTS_REL/<name>)
#   --public    make a newly created GitHub repo public (default private)
#   --on        do it on another machine from MACHINES (runs this script there over ssh);
#               --other is the same for the only other machine
#   --dry-run   say what would happen, change nothing
#
# Prints what it did and the Orca repo id to use with worker-start --repo id:<id>.
set -euo pipefail
. "$(dirname "$0")/_common.sh"

name=""; owner="$GITHUB_OWNER"; path=""; visibility=--private; on=""; dry=""
projects="$HOME/${PROJECTS_REL:-Code}"
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --owner) owner="$2"; shift 2 ;;
    --path) path="$2"; shift 2 ;;
    --public) visibility=--public; shift ;;
    --other) [ ${#OTHER_HOSTS[@]} = 1 ] || { echo "ensure-project: --other needs exactly one other machine; use --on <machine>" >&2; exit 2; }
             on="$OTHER_HOST"; shift ;;
    --on) on="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -*) echo "unknown option $1" >&2; exit 2 ;;
    *) name="$1"; shift ;;
  esac
done
[ -n "$name" ] || { sed -n '2,19p' "$0"; exit 2; }
[ -n "$owner" ] || { echo "ensure-project: no GitHub owner: set GITHUB_OWNER in chiefofstaff.conf or pass --owner" >&2; exit 2; }

if [ -n "$on" ] && [ "$on" != "$CHIEFOFSTAFF_HOST" ]; then
  ssh_alias="$(machine_field "$on" ssh)"
  [ -n "$ssh_alias" ] || { echo "ensure-project: no machine '$on' with an ssh alias in MACHINES" >&2; exit 2; }
  rest=(); skip=""
  for a in "${args[@]}"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    case "$a" in --other) ;; --on) skip=1 ;; *) rest+=("$(printf '%q' "$a")") ;; esac
  done
  exec ssh "$ssh_alias" "\$SHELL -lc 'cd ~/$CHIEFOFSTAFF_REL && git pull -q --ff-only && bin/ensure-project ${rest[*]}'"
fi

slug="$owner/$name"
if [ -z "$path" ]; then
  # Reuse an existing clone: one Orca already knows for this project, else one under
  # ~/$PROJECTS_REL (up to 3 levels, e.g. <projects>/Personal/<name>) whose origin is this repo.
  path="$("$ORCA" project setups --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin); r = d.get("result", d)
xs = r.get("setups", r.get("projectHostSetups", r)) if isinstance(r, dict) else r
for x in xs:
    if x.get("hostId") == "local" and (x.get("projectId") or "").lower() == ("github:" + sys.argv[1]).lower():
        print(x.get("path") or ""); break' "$slug")"
  if [ -z "$path" ]; then
    while IFS= read -r g; do
      d="${g%/.git}"
      u="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
      case "$(tr 'A-Z' 'a-z' <<<"$u")" in
        *"github.com:$(tr 'A-Z' 'a-z' <<<"$slug")"*|*"github.com/$(tr 'A-Z' 'a-z' <<<"$slug")"*) path="$d"; break ;;
      esac
    done < <(find "$projects" -maxdepth 4 -name .git -type d -not -path '*/orca/*' 2>/dev/null)
  fi
  path="${path:-$projects/$name}"
fi
ssh_url="git@github.com:$slug.git"
did=()
run() { if [ -n "$dry" ]; then echo "would: $*"; else "$@"; fi; }
note() { did+=("$1"); }

on_github() { gh repo view "$slug" --json name >/dev/null 2>&1; }

gh_exists=""; on_github && gh_exists=1
if [ -z "$gh_exists" ] && [ "$owner" != "$GITHUB_OWNER" ]; then
  echo "ensure-project: $slug isn't on GitHub and I won't create repos outside ${GITHUB_OWNER:-GITHUB_OWNER}. Ask $OPERATOR_NAME." >&2; exit 3
fi

# Current state (tracked in variables so --dry-run reports every step).
exists=""; has_git=""; has_commit=""; origin=""
[ -e "$path" ] && exists=1
[ -d "$path/.git" ] && has_git=1
[ -n "$has_git" ] && git -C "$path" rev-parse -q --verify HEAD >/dev/null 2>&1 && has_commit=1
[ -n "$has_git" ] && origin="$(git -C "$path" remote get-url origin 2>/dev/null || true)"

# 1-2. Folder and git.
if [ -z "$exists" ] && [ -n "$gh_exists" ]; then
  run git clone -q "$ssh_url" "$path"; note "cloned $slug to $path"
  exists=1; has_git=1; has_commit=1; origin="$ssh_url"
fi
if [ -z "$exists" ]; then run mkdir -p "$path"; note "created $path"; exists=1; fi
if [ -z "$has_git" ]; then run git -C "$path" init -q -b main; note "git init"; has_git=1; fi
if [ -z "$has_commit" ]; then
  if [ ! -d "$path" ] || [ -z "$(ls -A "$path" | grep -v '^\.git$' || true)" ]; then
    [ -n "$dry" ] || printf '# %s\n' "$name" > "$path/README.md"
    note "added README.md"
  fi
  run git -C "$path" add -A
  run git -C "$path" commit -qm "Initial commit"; note "first commit"; has_commit=1
fi

# 3. GitHub.
if [ -n "$origin" ]; then
  case "$origin" in
    *"github.com:$slug.git"|*"github.com:$slug"|*"github.com/$slug"|*"github.com/$slug.git"|*"github.com/$slug/") ;;
    *) echo "ensure-project: $path's origin is $origin, not $slug. Leaving it alone." >&2; exit 3 ;;
  esac
  [ -n "$gh_exists" ] || { echo "ensure-project: origin points at $slug but that GitHub repo doesn't exist or isn't visible." >&2; exit 3; }
elif [ -n "$gh_exists" ]; then
  run git -C "$path" remote add origin "$ssh_url"; note "set origin to $slug"
else
  run gh repo create "$slug" "$visibility" --source "$path" --remote origin --push
  [ -n "$dry" ] || git -C "$path" remote set-url origin "$ssh_url"
  note "created GitHub repo $slug (${visibility#--}) and pushed"
fi

# 4. Orca project on this machine. Orca may know the folder under another project id (a fork
# is recorded under its upstream); that still gives leads a usable repo id, so it counts.
# Local setups whose folder is gone are listed too (this slug's or any other).
setups_info="$("$ORCA" project setups --json 2>/dev/null | python3 -c '
import json, sys, os
p = os.path.realpath(sys.argv[1])
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
r = d.get("result", d)
xs = r.get("setups", r.get("projectHostSetups", r)) if isinstance(r, dict) else r
f = lambda v: str(v) if v else "-"
found = False
for x in xs if isinstance(xs, list) else []:
    if x.get("hostId") != "local": continue
    xp = x.get("path") or ""
    if xp and os.path.realpath(xp) == p and not found:
        found = True
        print("\t".join(["match", f(x.get("setupMethod")), f(x.get("projectId")), f(x.get("repoId"))]))
    if xp and not os.path.exists(xp):
        print("\t".join(["stale", f(x.get("id") or x.get("setupId")), f(x.get("projectId")), xp]))' "$path")"
setup=""; setup_proj=""; setup_repo=""; stale=()
while IFS=$'\t' read -r kind a1 a2 a3; do
  case "$kind" in
    match) setup="${a1#-}"; setup_proj="${a2#-}"; setup_repo="${a3#-}"; [ -n "$setup" ] || setup="?" ;;
    stale) stale+=("$a3 (project ${a2#-}, setup ${a1#-}): orca project setup-delete --setup ${a1#-}") ;;
  esac
done <<<"$setups_info"
other_proj=""
if [ -n "$setup" ] && [ "$(tr 'A-Z' 'a-z' <<<"$setup_proj")" != "$(tr 'A-Z' 'a-z' <<<"github:$slug")" ]; then
  other_proj=1
  notes_extra="Orca has it as project ${setup_proj:-<none>} (a fork's upstream); fine for leads"
elif [ "$setup" != imported-existing-folder ] && [ "$setup" != cloned ]; then
  if [ -n "$dry" ]; then
    echo "would: $ORCA project setup-existing-folder --project github:$slug --host local --path $path --kind git"
  elif ! out="$("$ORCA" project setup-existing-folder --project "github:$slug" --host local --path "$path" --kind git --json 2>&1)" \
       || grep -q '"ok": *false' <<<"$out"; then
    if [ -n "$setup_repo" ]; then
      refused=1; did+=("warning: legacy upgrade refused; using the existing repo id")
      echo "ensure-project: warning: Orca refused to upgrade $path (a $setup setup) to project github:$slug; the existing repo id still works:" >&2
      echo "  $(head -c 400 <<<"$out")" >&2
    else
      echo "ensure-project: Orca refused to add $path as project github:$slug${setup:+ (it has it as a $setup setup)}:" >&2
      echo "  $(head -c 400 <<<"$out")" >&2
      [ ${#did[@]} -eq 0 ] || printf '  done before that: %s\n' "${did[@]}" >&2
      exit 1
    fi
  fi
  [ -n "${refused:-}" ] || note "${setup:+upgraded legacy link; }added to Orca as project github:$slug"
fi

repo_id="$("$ORCA" repo list 2>/dev/null | awk -v p="$path" '$3 == p {print $1}' | head -1)"
[ -n "$repo_id" ] || repo_id="$setup_repo"
echo "ensure-project: $slug on $CHIEFOFSTAFF_HOST at $path"
if [ ${#did[@]} -eq 0 ]; then echo "  already set up; nothing to do"; else printf '  %s\n' "${did[@]}"; fi
echo "  orca repo id: ${repo_id:-<unknown${dry:+ (dry run)}>}"
if [ -n "$other_proj" ]; then echo "  already set up: $notes_extra"; fi
if [ ${#stale[@]} -gt 0 ]; then
  echo "  Orca setups whose folder is missing (remove with the command shown; I never run it):"
  printf '    %s\n' "${stale[@]}"
fi
